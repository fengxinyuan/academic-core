# ==========================================
# academic_core 统一配置文件 (.env.example)
# 请复制本文件为 .env 并填入您所使用的模型密钥
# ==========================================

# 1. 阿里云百炼平台 (DashScope - 通义千问 Qwen-VL-OCR, Qwen-Plus) [手写笔记推荐]
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 2. MinerU 官方云端文档解析 API (双栏学术论文、复杂表格与插图提取推荐)
MINERU_TOKEN=your_mineru_token_here

# 3. OpenAI API 或任意 OpenAI 兼容端点 (GPT-4o, OpenRouter, OneAPI, SiliconFlow, Ollama, vLLM)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# 4. DeepSeek API (DeepSeek-V3 / R1 学术推理与翻译)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 5. Google Gemini API (Gemini-1.5/2.0 Flash / Pro 视觉与文本推理)
GEMINI_API_KEY=your_gemini_api_key_here

# 6. 自定义无头 Chrome / Edge / Chromium 可执行文件路径 (可选，留空则跨平台自动检测)
# CHROME_PATH=/usr/bin/google-chrome
