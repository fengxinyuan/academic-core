# ==========================================
# academic_core 统一配置文件 (.env.example)
# 请复制本文件为 .env 并填入您所使用的模型密钥
# ==========================================

# 1. 阿里云百炼平台 (DashScope - 通义千问 Qwen-VL-OCR, Qwen-Plus) [推荐]
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 2. OpenAI API 或兼容端点 (GPT-4o, 本地 vLLM / Ollama)
OPENAI_API_KEY=your_openai_api_key_here

# 3. DeepSeek API (DeepSeek-V3 / R1 推理)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 4. Google Gemini API (Gemini-1.5-Flash / Pro)
GEMINI_API_KEY=your_gemini_api_key_here

# 5. 自定义无头 Chrome / Edge / Chromium 可执行文件路径 (可选，留空则自动检测)
# CHROME_PATH=/usr/bin/google-chrome
